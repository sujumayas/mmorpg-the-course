{
  "start": "greet",
  "nodes": {
    "greet":           {"text": "Forge's hot. What do you need?",
                        "choices": [{"text": "Prices?", "goto": "ask_price"},
                                    {"text": "Heard any news?", "goto": "ask_rumor"},
                                    {"text": "Just looking.", "goto": "leave"}]},
    "ask_price":       {"text": "Blades are forty gold. Shields, thirty.",
                        "choices": [{"text": "Too steep.", "goto": "haggle"},
                                    {"text": "I'll take a blade.", "goto": "buy"},
                                    {"text": "Never mind.", "goto": "greet"}]},
    "haggle":          {"text": "Steep? Hmph. Thirty-five, and I'm losing coin.",
                        "choices": [{"text": "Deal.", "goto": "buy"},
                                    {"text": "Thirty.", "goto": "haggel_fail"},
                                    {"text": "Forget it.", "goto": "leave"}]},
    "haggle_fail":     {"text": "Out. Come back when you're serious.",
                        "end": true},
    "buy":             {"text": "Good steel. Don't bend it on a door.",
                        "choices": [{"text": "Thanks.", "goto": "bye_friend"}]},
    "ask_rumor":       {"text": "Miners saw lights in the old quarry.",
                        "choices": [{"text": "Lights?", "goto": "rumor_detail"},
                                    {"text": "Anything else?", "goto": "rumor_two"}]},
    "rumor_detail":    {"text": "Blue ones. Moving against the wind.",
                        "choices": []},
    "rumor_two":       {"text": "The mayor's been buying a lot of rope.",
                        "choices": [{"text": "Odd. Back to business.", "goto": "ask_price"}]},
    "secret_discount": {"text": "For you, friend of the guild, twenty-five.",
                        "choices": [{"text": "Deal.", "goto": "buy"}]},
    "old_debt":        {"text": "You still owe me for that axe.",
                        "choices": [{"text": "Here.", "goto": "secret_discount"}]},
    "leave":           {"text": "Suit yourself.",
                        "end": true},
    "bye_friend":      {"text": "Come back if it chips.",
                        "end": true}
  }
}
